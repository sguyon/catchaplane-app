# Catch-A-Plane Environment Variables
# Copy this file to .env.local and fill in your API keys

# Claude Haiku for AI story generation (Phase 3+)
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI for TTS voice narration + DALL-E image generation (Phase 4-5+)
OPENAI_API_KEY=sk-...

# Flight data provider: "opensky" (default, free) or "adsb"
FLIGHT_API_PROVIDER=opensky

# Image generation provider: "openai" (DALL-E) or "fal"
IMAGE_PROVIDER=openai

# fal.ai key for avatar generation + faster image generation (Phase 8+)
# Optional: without this, avatars will use emoji placeholders
FAL_KEY=
